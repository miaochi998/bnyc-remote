diff --git a/apps/desktop/src/gui/features/addressbook/addressbook.cpp b/apps/desktop/src/gui/features/addressbook/addressbook.cpp
new file mode 100644
index 0000000..d737095
--- /dev/null
+++ b/apps/desktop/src/gui/features/addressbook/addressbook.cpp
@@ -0,0 +1,123 @@
+#include "addressbook.h"
+
+#include <httplib.h>
+#include <nlohmann/json.hpp>
+
+#include <utility>
+
+namespace crossdesk {
+
+AddressBook::AddressBook(std::string server_url, std::string token)
+    : server_url_(std::move(server_url)), token_(std::move(token)) {
+  while (!server_url_.empty() && server_url_.back() == '/')
+    server_url_.pop_back();
+}
+
+void AddressBook::SetServerUrl(std::string server_url) {
+  while (!server_url.empty() && server_url.back() == '/') server_url.pop_back();
+  server_url_ = std::move(server_url);
+}
+
+void AddressBook::SetToken(std::string token) { token_ = std::move(token); }
+
+bool AddressBook::Request(const std::string& method, const std::string& path,
+                          const std::string& body, std::string* response,
+                          std::string* error) const {
+  if (server_url_.empty()) {
+    if (error) *error = "address book server is not configured";
+    return false;
+  }
+
+  httplib::Client cli(server_url_);
+  cli.set_connection_timeout(5);
+  cli.set_read_timeout(10);
+  cli.set_write_timeout(10);
+  cli.set_max_timeout(15000);
+  cli.set_follow_location(true);
+
+  httplib::Headers headers;
+  headers.emplace("Accept", "application/json");
+  if (!token_.empty())
+    headers.emplace("Authorization", "Bearer " + token_);
+
+  httplib::Result result(nullptr, httplib::Error::Unknown);
+  if (method == "POST") {
+    result = cli.Post(path, headers, body, "application/json");
+  } else if (method == "PUT") {
+    result = cli.Put(path, headers, body, "application/json");
+  } else if (method == "DELETE") {
+    result = cli.Delete(path, headers);
+  } else {
+    result = cli.Get(path, headers);
+  }
+
+  if (!result) {
+    if (error) {
+      *error = "request failed: " + httplib::to_string(result.error());
+    }
+    return false;
+  }
+  if (response) *response = result->body;
+  if (result->status < 200 || result->status >= 300) {
+    if (error) {
+      auto parsed = nlohmann::json::parse(result->body, nullptr, false);
+      if (!parsed.is_discarded() && parsed.contains("error") &&
+          parsed["error"].is_string()) {
+        *error = parsed["error"].get<std::string>();
+      } else {
+        *error = "HTTP " + std::to_string(result->status);
+      }
+    }
+    return false;
+  }
+  return true;
+}
+
+bool AddressBook::Login(const std::string& username,
+                        const std::string& password, std::string* error) {
+  nlohmann::json request = {{"username", username}, {"password", password}};
+  std::string response;
+  if (!Request("POST", "/api/login", request.dump(), &response, error))
+    return false;
+
+  auto parsed = nlohmann::json::parse(response, nullptr, false);
+  if (parsed.is_discarded() || !parsed.contains("token") ||
+      !parsed["token"].is_string()) {
+    if (error) *error = "unexpected login response";
+    return false;
+  }
+  token_ = parsed["token"].get<std::string>();
+  return !token_.empty();
+}
+
+bool AddressBook::FetchDevices(std::vector<AddressBookDevice>* devices,
+                               std::string* error) {
+  if (!devices) return false;
+  if (token_.empty()) {
+    if (error) *error = "not logged in";
+    return false;
+  }
+  std::string response;
+  if (!Request("GET", "/api/devices", "", &response, error)) return false;
+
+  auto parsed = nlohmann::json::parse(response, nullptr, false);
+  if (parsed.is_discarded() || !parsed.is_array()) {
+    if (error) *error = "unexpected address book response";
+    return false;
+  }
+  devices->clear();
+  for (const auto& item : parsed) {
+    if (!item.is_object()) continue;
+    AddressBookDevice device;
+    device.id = item.value("id", 0L);
+    device.name = item.value("name", std::string{});
+    device.remote_id = item.value("remote_id", std::string{});
+    device.password = item.value("password", std::string{});
+    device.note = item.value("note", std::string{});
+    if (device.remote_id.empty()) continue;
+    devices->push_back(std::move(device));
+  }
+  return true;
+}
+
+}  // namespace crossdesk
diff --git a/apps/desktop/src/gui/features/addressbook/addressbook.h b/apps/desktop/src/gui/features/addressbook/addressbook.h
new file mode 100644
index 0000000..375aa1d
--- /dev/null
+++ b/apps/desktop/src/gui/features/addressbook/addressbook.h
@@ -0,0 +1,55 @@
+/*
+ * bnyc-remote address book client for the CrossDesk desktop app.
+ * Talks to the bnyc-remote portal API (accounts + address book).
+ * Part of the bnyc-remote patch set; see client/patches/.
+ */
+
+#ifndef bnyc_addressbook_h
+#define bnyc_addressbook_h
+
+#include <string>
+#include <vector>
+
+namespace crossdesk {
+
+struct AddressBookDevice {
+  long id = 0;
+  std::string name;
+  std::string remote_id;
+  std::string password;
+  std::string note;
+};
+
+// Minimal HTTP client for the portal API. Configured from config.ini by the
+// caller; never contains hard-coded servers or credentials (R1).
+class AddressBook {
+ public:
+  AddressBook() = default;
+  AddressBook(std::string server_url, std::string token);
+
+  void SetServerUrl(std::string server_url);
+  void SetToken(std::string token);
+  const std::string& server_url() const { return server_url_; }
+  const std::string& token() const { return token_; }
+  bool HasToken() const { return !token_.empty(); }
+
+  // POST /api/login. On success stores the JWT and returns true.
+  bool Login(const std::string& username, const std::string& password,
+             std::string* error);
+
+  // GET /api/devices. Requires a token.
+  bool FetchDevices(std::vector<AddressBookDevice>* devices,
+                    std::string* error);
+
+ private:
+  bool Request(const std::string& method, const std::string& path,
+               const std::string& body, std::string* response,
+               std::string* error) const;
+
+  std::string server_url_;
+  std::string token_;
+};
+
+}  // namespace crossdesk
+
+#endif  // bnyc_addressbook_h
