+void GuiApplication::InitializeAddressBook() {
+  if (!config_center_) return;
+  const auto server = config_center_->GetAddressBookServer();
+  if (server.empty()) return;
+  address_book_.SetServerUrl(server);
+  address_book_.SetToken(config_center_->GetAddressBookToken());
+  if (!address_book_.HasToken()) {
+    LOG_INFO("Address book configured but no token; skipped");
+    return;
+  }
+  SyncAddressBook();
+}
+
+void GuiApplication::SyncAddressBook() {
+  if (!thumbnail_) return;
+  std::thread([this] {
+    std::vector<AddressBookDevice> devices;
+    std::string error;
+    if (!address_book_.FetchDevices(&devices, &error)) {
+      LOG_WARN("Address book fetch failed: {}", error);
+      return;
+    }
+    size_t added = 0;
+    for (const auto& device : devices) {
+      if (thumbnail_->SaveToThumbnail(nullptr, 0, 0, device.remote_id,
+                                      device.name, device.password,
+                                      HostPlatform::Unknown) == 0)
+        ++added;
+    }
+    LOG_INFO("Address book synced: {} devices", added);
+    reload_recent_connections_ = true;
+  }).detach();
+}
