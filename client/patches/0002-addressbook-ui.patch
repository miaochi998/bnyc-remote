+  main->on_addressbook_login_submit([this, main] {
+    const std::string server(main->get_addressbook_server());
+    const std::string username(main->get_addressbook_username());
+    const std::string password(main->get_addressbook_password());
+    if (server.empty() || username.empty() || password.empty()) {
+      main->set_addressbook_error("请填写服务器、用户名和密码");
+      return;
+    }
+    main->set_addressbook_error("");
+    std::thread([this, server, username, password] {
+      AddressBook client(server, "");
+      std::string error;
+      if (!client.Login(username, password, &error)) {
+        slint::invoke_from_event_loop([this, error] {
+          if (ui_)
+            ui_->main->set_addressbook_error(slint::SharedString(error));
+        });
+        return;
+      }
+      const std::string token = client.token();
+      slint::invoke_from_event_loop([this, server, token] {
+        if (config_center_) {
+          config_center_->SetAddressBookServer(server);
+          config_center_->SetAddressBookToken(token);
+        }
+        address_book_.SetServerUrl(server);
+        address_book_.SetToken(token);
+        SyncAddressBook();
+        if (ui_) {
+          ui_->main->set_addressbook_error("");
+          ui_->main->set_addressbook_password(slint::SharedString(""));
+          ui_->main->set_addressbook_login_open(false);
+        }
+      });
+    }).detach();
+  });
+  main->on_addressbook_login_dismiss([this, main] {
+    main->set_addressbook_error("");
+    main->set_addressbook_password(slint::SharedString(""));
+    main->set_addressbook_login_open(false);
+  });
   main->on_connect_requested(
