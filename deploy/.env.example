# 全部为占位符。真实值只存在于服务器本地 /opt/stacks/<项目>/.env，禁止提交。
# --- crossdesk-server ---
EXTERNAL_IP=CHANGE_ME
INTERNAL_IP=CHANGE_ME
CROSSDESK_SERVER_PORT=9099
COTURN_PORT=3478
MIN_PORT=49152
MAX_PORT=49161
COTURN_AUTH_SECRET=CHANGE_ME
COTURN_STATELESS_NONCE_SECRET=CHANGE_ME
CROSSDESK_DATA_DIR=/var/lib/crossdesk
CROSSDESK_LOG_DIR=/var/log/crossdesk
COTURN_PUBLIC_HOST=coturn.example.com

# --- portal ---
PORTAL_LISTEN=:8080
PORTAL_DB_PATH=/data/portal.db
# 至少 32 字符；用 openssl rand -base64 48 生成
PORTAL_JWT_SECRET=CHANGE_ME
# 64 个 hex 字符（32 字节）；用 openssl rand -hex 32 生成
PORTAL_DEVICE_KEY=CHANGE_ME
# 首次启动时创建管理员；之后可删除
PORTAL_ADMIN_USER=admin
PORTAL_ADMIN_PASSWORD=CHANGE_ME
# 允许的 Web 端来源，逗号分隔；留空不启用 CORS
PORTAL_ALLOW_ORIGINS=
