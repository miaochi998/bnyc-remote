# 全部为占位符。真实值只存在于服务器本地 /opt/stacks/<项目>/.env，禁止提交。

# ---------- CrossDesk 信令 + Coturn ----------
# 固定镜像 tag，禁止 latest
CROSSDESK_IMAGE=crossdesk/crossdesk-server:CHANGE_ME
COTURN_IMAGE=coturn/coturn:CHANGE_ME
EXTERNAL_IP=CHANGE_ME
INTERNAL_IP=CHANGE_ME
CROSSDESK_SERVER_PORT=9099
COTURN_PORT=3478
# 中继端口段已收窄（原 50000-60000）
MIN_PORT=49152
MAX_PORT=49161
COTURN_REALM=crossdesk
# 客户端的 STUN/TURN 地址；为空时用 EXTERNAL_IP
COTURN_PUBLIC_HOST=
CROSSDESK_DATA_DIR=/var/lib/crossdesk
CROSSDESK_LOG_DIR=/var/log/crossdesk
CROSSDESK_NOFILE=32768
# 生成：openssl rand -hex 32
COTURN_AUTH_SECRET=CHANGE_ME
# 生成：openssl rand -hex 32（保持稳定可避免重启后 438 重认证）
COTURN_STATELESS_NONCE_SECRET=CHANGE_ME
COTURN_CREDENTIAL_TTL_SECONDS=3600
# 可选完整 ICE 列表；为空用 COTURN_PUBLIC_HOST/EXTERNAL_IP 默认
CROSSDESK_ICE_SERVERS=
# 可选管理台账号；两者都空则不启用
ADMIN_USERNAME=
ADMIN_PASSWORD=
COTURN_LOG_LEVEL=warning
COTURN_MEMORY_LIMIT=512m

# ---------- portal（自研账号/地址簿）----------
PORTAL_LISTEN=:8080
PORTAL_DB_PATH=/data/portal.db
# 至少 32 字符；openssl rand -base64 48
PORTAL_JWT_SECRET=CHANGE_ME
# 64 个 hex 字符（32 字节）；openssl rand -hex 32
PORTAL_DEVICE_KEY=CHANGE_ME
# 首次启动创建管理员；之后可删除
PORTAL_ADMIN_USER=admin
PORTAL_ADMIN_PASSWORD=CHANGE_ME
# 允许的 Web 端来源，逗号分隔；留空不启用 CORS
PORTAL_ALLOW_ORIGINS=
